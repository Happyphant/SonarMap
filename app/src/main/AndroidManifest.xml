<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MapKit and Google Maps both load tiles over network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Real user positioning. Runtime request happens at the FAB tap,
         never at startup. No background location: the foreground playback
         service is always started from the visible UI, so while-in-use
         authorization covers the whole walking session. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Foreground playback service ("Фоновый режим", user opt-in via an
         explicit map-screen toggle): continuous geolocation + spatial
         audio while minimized. Types declared on the <service> below
         require these three permissions; POST_NOTIFICATIONS is the FGS
         notification's visibility on API 33+ (runtime request when the
         toggle enables the service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SonarMapApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="SonarMap"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonarMap">

        <!-- Google Maps runtime key; substituted at build time from local.properties -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Continuous playback ("Фоновый режим"). exported=false: only
             this app starts it (startForegroundService from the map
             screen). The type combination location|mediaPlayback must
             match BOTH startForeground type masks in the service.
             mediaPlayback keeps the session alive on task removal;
             location keeps the fixes flowing for spatial audio. -->
        <service
            android:name=".service.PlaybackForegroundService"
            android:exported="false"
            android:foregroundServiceType="location|mediaPlayback" />
    </application>

</manifest>
